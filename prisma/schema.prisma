generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Application {
  id               String   @id @default(cuid())
  company          String
  position         String
  jobUrl           String   @default("")
  location         String   @default("")
  arrangement      String   @default("Unspecified")
  term             String   @default("")
  deadline         String   @default("")
  dateApplied      String   @default("")
  status           String   @default("Saved")
  priority         String   @default("Medium")
  nextAction       String   @default("")
  nextActionDue    String   @default("")
  contactName      String   @default("")
  contactEmail     String   @default("")
  resume           String   @default("")
  coverLetter      String   @default("")
  transcript       String   @default("")
  resumeDocumentId String   @default("")
  letterDocumentId String   @default("")
  transcriptDocumentId String @default("")
  notes            String   @default("")
  sourceEmailUrl   String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  activities       Activity[]
  interviews       Interview[]
  statusEvents     StatusEvent[]

  @@index([status])
}

model Document {
  id         String   @id @default(cuid())
  name       String
  version    String
  kind       String
  fileName   String
  mimeType   String
  size       Int
  sha256     String
  content    Bytes
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([kind, archived])
}

model Activity {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String
  message       String
  createdAt     DateTime    @default(now())
  @@index([applicationId, createdAt])
}

model Interview {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title String
  startAt DateTime
  timeZone String
  duration Int @default(60)
  interviewer String @default("")
  location String @default("")
  meetingUrl String @default("")
  preparation String @default("")
  notes String @default("")
  state String @default("Scheduled")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([startAt])
}

model StatusEvent {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status String
  occurredAt DateTime @default(now())
  @@index([applicationId, occurredAt])
}

model EmailReview {
  id String @id @default(cuid())
  fingerprint String @unique
  subject String
  sender String @default("")
  body String
  sourceUrl String @default("")
  evidence String @default("")
  proposedStatus String @default("")
  state String @default("pending")
  applicationId String @default("")
  createdAt DateTime @default(now())
  reviewedAt DateTime?
}

model GmailMessage {
  key String @id
  messageId String
  reviewId String @default("")
  processedAt DateTime @default(now())
}
