{
  "name": "internship-hq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:restart": "node --import tsx scripts/verify-restart.ts",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:install": "node scripts/install-desktop.mjs",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "db:init": "node --import tsx scripts/prepare-db.ts && prisma migrate deploy && prisma generate",
    "db:migrate": "prisma migrate dev",
    "demo": "node --import tsx scripts/demo.ts",
    "dev:demo": "DATABASE_URL=file:./prisma/demo.db DEMO_MODE=true next dev --webpack --hostname 127.0.0.1 --port 3001",
    "db:backup": "node --import tsx scripts/backup.ts",
    "format": "prettier --write src scripts tests *.ts *.json *.mjs prisma/schema.prisma --ignore-unknown"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
